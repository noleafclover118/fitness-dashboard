{
  "name": "fitness-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/build-sw.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  }
}
